# Get your key at https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-your-key-here

# Your Riot ID (game name + tag, e.g. SummonerName#NA1)
RIOT_GAME_NAME=YourSummonerName
RIOT_TAG_LINE=NA1

# Platform routing (na1, euw1, kr, etc.)
RIOT_PLATFORM=na1

# Regional routing for match/account APIs (americas, europe, asia, sea)
RIOT_REGION=americas
